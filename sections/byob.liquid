{% liquid
  assign byob_collection = section.settings.collection
%}

<section
  id="BYOB-{{ section.id }}"
  class="byob-builder py-5"
  data-byob
  data-section-id="{{ section.id }}"
>
  <div class="container">

    <div class="row mb-4">
      <div class="col-12 text-center">
        <h1 class="h2 mb-2">
          {{ section.settings.heading }}
        </h1>

        {% if section.settings.description != blank %}
          <div class="mb-0">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="row">

      <!-- PRODUCTS -->
      <div class="col-12 col-lg-8">

        {% if byob_collection != blank and byob_collection.products_count > 0 %}

          <div class="row g-3" data-byob-products>

            {% for product in byob_collection.products %}

              {% assign variant = product.selected_or_first_available_variant %}

              <div
                class="col-12 col-sm-6 col-md-4"
                data-byob-product
                data-product-id="{{ product.id }}"
                data-variant-id="{{ variant.id }}"
                data-product-title="{{ product.title | escape }}"
                data-price="{{ variant.price }}"
                data-available="{{ variant.available }}"
              >

                <div class="card h-100">

                  <div class="ratio ratio-1x1">
                    {% if product.featured_image %}
                      {{
                        product.featured_image
                        | image_url: width: 500
                        | image_tag:
                          loading: 'lazy',
                          class: 'card-img-top object-fit-cover',
                          alt: product.featured_image.alt | escape
                      }}
                    {% endif %}
                  </div>

                  <div class="card-body d-flex flex-column">

                    <h2 class="h6">
                      {{ product.title }}
                    </h2>

                    <div class="mb-3">
                      {{ variant.price | money }}
                    </div>

                    {% if variant.available %}

                      <div
                        class="input-group mt-auto"
                        data-byob-quantity-control
                      >

                        <button
                          type="button"
                          class="btn btn-outline-secondary"
                          data-byob-decrease
                          aria-label="Decrease quantity"
                        >
                          −
                        </button>

                        <input
                          type="number"
                          class="form-control text-center"
                          value="1"
                          min="1"
                          max="99"
                          inputmode="numeric"
                          data-byob-quantity
                          aria-label="{{ product.title }} quantity"
                        >

                        <button
                          type="button"
                          class="btn btn-outline-secondary"
                          data-byob-increase
                          aria-label="Increase quantity"
                        >
                          +
                        </button>

                      </div>

                    {% else %}

                      <div class="mt-auto">
                        <span class="badge text-bg-secondary">
                          Sold out
                        </span>
                      </div>

                    {% endif %}

                  </div>

                </div>

              </div>

            {% endfor %}

          </div>

        {% else %}

          <div class="alert alert-warning">
            No BYOB products are currently available.
          </div>

        {% endif %}

      </div>

      <!-- SUMMARY -->
      <div class="col-12 col-lg-4 mt-4 mt-lg-0">

        <div
          class="card sticky-lg-top"
          style="top: 1rem;"
          data-byob-summary
        >

          <div class="card-body">

            <h2 class="h5">
              {{ section.settings.summary_heading }}
            </h2>

            <hr>

            <div class="d-flex justify-content-between mb-2">
              <span>Items</span>
              <strong data-byob-total-items>0</strong>
            </div>

            <div class="d-flex justify-content-between mb-2">
              <span>Subtotal</span>
              <strong data-byob-subtotal>
                {{ 0 | money }}
              </strong>
            </div>

            <div
              class="d-flex justify-content-between mb-2"
              data-byob-discount-row
              hidden
            >
              <span data-byob-discount-label>
                Discount
              </span>

              <strong data-byob-discount>
                -{{ 0 | money }}
              </strong>
            </div>

            <hr>

            <div class="d-flex justify-content-between mb-3">
              <span>Total</span>
              <strong data-byob-total>
                {{ 0 | money }}
              </strong>
            </div>

            <div
              class="alert alert-info small"
              data-byob-tier-message
              hidden
            ></div>

            <div
              class="alert alert-danger small"
              data-byob-error
              hidden
            ></div>

            <button
              type="button"
              class="btn btn-primary w-100"
              data-byob-add
              disabled
            >
              {{ section.settings.button_text }}
            </button>

            <div
              class="mt-3 text-center small"
              data-byob-status
              aria-live="polite"
            ></div>

          </div>

        </div>

      </div>

    </div>

  </div>
</section>

<script>
  window.BYOB_CONFIG = window.BYOB_CONFIG || {};

  window.BYOB_CONFIG["{{ section.id }}"] = {
    currency: {{ shop.currency | json }},
    moneyFormat: {{ shop.money_format | json }},
    maxQuantityPerProduct: 99
  };
</script>

{% schema %}
{
  "name": "Build Your Own Box",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "BYOB products"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Own Box"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Choose your favourite products.</p>"
    },
    {
      "type": "text",
      "id": "summary_heading",
      "label": "Summary heading",
      "default": "Your Box"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Add Box to Cart"
    }
  ],
  "presets": [
    {
      "name": "Build Your Own Box"
    }
  ]
}
{% endschema %}